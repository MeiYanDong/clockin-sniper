# Non-secret configuration for the keyless public Control Sentinel.
CLOCKIN_OPS_HOST=127.0.0.1
CLOCKIN_OPS_PORT=8080
CLOCKIN_STATUS_DIR=/run/clockin-status
CLOCKIN_CONTROL_ID=clockin-control:production
CLOCKIN_PUBLIC_HEAD_POLL_MS=2000
CLOCKIN_PUBLIC_IDENTITY_REFRESH_MS=300000
CLOCKIN_PUBLIC_WALLET_REFRESH_MS=3600000
