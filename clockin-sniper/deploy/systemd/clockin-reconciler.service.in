[Unit]
Description=ClockIn UNKNOWN and receipt reconciler
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target
StartLimitIntervalSec=60s
StartLimitBurst=8

[Service]
Type=simple
User=clockin
Group=clockin
WorkingDirectory=@ARTIFACT_DIR@/clockin-sniper
EnvironmentFile=/etc/clockin-sniper/strategy.env
LoadCredential=rpc_http:/etc/clockin-sniper/credentials/rpc_http
LoadCredential=vault_key:/etc/clockin-sniper/credentials/vault_key
ExecStart=@RECONCILER_EXECUTABLE@
Restart=on-failure
RestartSec=3s
TimeoutStopSec=45s
KillSignal=SIGTERM
UMask=0077
RuntimeDirectory=clockin-reconciler
RuntimeDirectoryMode=0700
StateDirectory=clockin-sniper
StateDirectoryMode=0700
StandardOutput=journal
StandardError=journal
SyslogIdentifier=clockin-reconciler
LogRateLimitIntervalSec=30s
LogRateLimitBurst=500
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectProc=invisible
ProcSubset=pid
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/clockin-sniper /run/clockin-reconciler

[Install]
WantedBy=multi-user.target
