[Unit]
Description=ClockIn Control Sentinel (keyless)
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target
StartLimitIntervalSec=60s
StartLimitBurst=8

[Service]
Type=notify
NotifyAccess=all
WatchdogSec=30s
User=clockin-observer
Group=clockin-observer
SupplementaryGroups=clockin-status
WorkingDirectory=@ARTIFACT_DIR@/clockin-sniper
EnvironmentFile=-/etc/clockin-sniper/control.env
Environment=CLOCKIN_MANIFEST_PATH=/etc/clockin-sniper/public/entry-manifest.json
Environment=CLOCKIN_STATE_DIR=/var/lib/clockin-control
Environment=CLOCKIN_PUBLIC_HANDOFF_DIR=/var/lib/clockin-handoff/outbox
ExecStart=@CONTROL_EXECUTABLE@
Restart=on-failure
RestartSec=2s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0077
RuntimeDirectory=clockin-control
RuntimeDirectoryMode=0700
StateDirectory=clockin-control
StateDirectoryMode=0700
StandardOutput=journal
StandardError=journal
SyslogIdentifier=clockin-control
LogRateLimitIntervalSec=30s
LogRateLimitBurst=500
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectProc=invisible
ProcSubset=pid
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/clockin-control /var/lib/clockin-handoff /run/clockin-control /run/clockin-status

[Install]
WantedBy=multi-user.target
