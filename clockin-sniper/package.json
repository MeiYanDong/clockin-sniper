{
  "name": "@local/clockin-sniper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ClockIn Robinhood mainnet live dynamic-fee tranche executor",
  "engines": {
    "node": ">=24 <26"
  },
  "scripts": {
    "secrets:check": "node --import tsx src/check-repo-secrets.ts",
    "format": "biome format --write src test package.json tsconfig.json biome.json",
    "format:check": "biome format src test package.json tsconfig.json biome.json",
    "lint": "biome lint src test",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "coverage": "tsx --test --experimental-test-coverage --test-coverage-lines=85 --test-coverage-branches=60 --test-coverage-functions=80 test/**/*.test.ts",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "package:audit": "npm pack --dry-run",
    "smoke:rpc": "node --import tsx --import ./src/load-secrets.ts src/smoke-rpc.ts",
    "smoke:wss": "node --import tsx --import ./src/load-secrets.ts src/smoke-wss.ts",
    "smoke:sequencer": "node --import tsx src/smoke-sequencer.ts",
    "wallet:create": "node --import tsx src/create-wallet.ts",
    "live": "node --import tsx --import ./src/load-secrets.ts src/live-factory.ts",
    "live:known-target": "node --import tsx --import ./src/load-secrets.ts src/live.ts",
    "live:reconcile": "node --import tsx --import ./src/load-secrets.ts src/reconcile-live.ts",
    "verify": "npm run secrets:check && npm run format:check && npm run lint && npm run typecheck && npm run coverage && npm run audit:prod && npm run package:audit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "ethers": "^6.17.0"
  }
}
