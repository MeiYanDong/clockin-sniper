{
  "name": "@local/clockin-sniper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ClockIn Robinhood mainnet live dynamic-fee tranche executor",
  "main": "./dist/v2-index.js",
  "types": "./dist/v2-index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/v2-index.d.ts",
      "import": "./dist/v2-index.js"
    }
  },
  "engines": {
    "node": ">=24 <26"
  },
  "files": [
    "dist/",
    "deploy/",
    "README.md",
    "capability-manifest.json",
    "BUILD-METADATA.json",
    "npm-shrinkwrap.json"
  ],
  "scripts": {
    "secrets:check": "node --import tsx src/check-repo-secrets.ts",
    "secrets:history": "node ../scripts/check-git-history-secrets.mjs",
    "format": "biome format --write src test package.json tsconfig.json tsconfig.build.json biome.json",
    "format:check": "biome format src test package.json tsconfig.json tsconfig.build.json biome.json",
    "lint": "biome lint src test",
    "typecheck": "tsc --noEmit",
    "build": "node ../scripts/clean-build.mjs && tsc -p tsconfig.build.json",
    "test": "tsx --test test/**/*.test.ts",
    "coverage:core": "tsx --test --experimental-test-coverage --test-coverage-include='src/{adapters,broadcast,config,control,core,effects,entry,exit,identity,observability,ops,persistence,positions,runtime,strategies,wallets}/**/*.ts' --test-coverage-lines=85 --test-coverage-branches=60 --test-coverage-functions=80 test/**/*.test.ts",
    "coverage:production-entrypoints": "tsx --test --experimental-test-coverage --test-coverage-include='src/{control-service,stonk-safe-launch-executor-service,prepare-stonk-safe-launch-wallets,reconciler-service,exit-service}.ts' --test-coverage-lines=28 --test-coverage-branches=70 --test-coverage-functions=60 test/production-entrypoints-coverage.test.ts test/stonk-safe-launch-executor.test.ts test/prepare-stonk-safe-launch-wallets.test.ts test/exit-service-lifecycle.test.ts",
    "coverage": "npm run coverage:core && npm run coverage:production-entrypoints",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "package:dry-run": "npm pack --dry-run",
    "package:audit": "npm run package:dry-run && node ../scripts/check-package-archive.mjs --pack",
    "prepack": "npm run build && node ../scripts/build-release-metadata.mjs",
    "smoke:rpc": "node --import tsx --import ./src/load-secrets.ts src/smoke-rpc.ts",
    "smoke:wss": "node --import tsx --import ./src/load-secrets.ts src/smoke-wss.ts",
    "smoke:sequencer": "node --import tsx src/smoke-sequencer.ts",
    "control:stage-credentials": "node --import tsx --import ./src/load-secrets.ts src/stage-control-credentials.ts",
    "wallet:create": "node --import tsx src/create-wallet.ts",
    "wallets:create": "node --import tsx src/create-wallet-batch.ts",
    "wallets:prepare:safe-launch": "node dist/prepare-stonk-safe-launch-wallets.js",
    "profile:render:safe-launch": "node --import tsx src/render-stonk-safe-launch-production-credentials.ts",
    "control": "node dist/control-service.js",
    "executor": "node dist/stonk-safe-launch-executor-service.js",
    "reconciler": "node dist/reconciler-service.js",
    "exit": "node dist/exit-service.js",
    "verify": "npm run secrets:check && npm run secrets:history && npm run format:check && npm run lint && npm run typecheck && npm run coverage && npm run audit:prod && npm run package:audit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "ethers": "^6.17.0"
  }
}
